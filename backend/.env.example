# Copy this to .env for local overrides (optional — sensible defaults exist without it)

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Leave these unset for local dev — the app then uses a plain SQLite file
# (backend/pg_rent.db). Set both in production to use a hosted Turso database
# instead, so tenant data survives redeploys. See DEPLOY.md for how to get these.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here
